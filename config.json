{
    "Antigravity": {
        "log_patterns": [
            "~/.gemini/antigravity-cli/log/cli-*.log",
            "~/.gemini/antigravity-cli/brain/**/*.jsonl"
        ],
        "keywords": ["Surfacing tool confirmation", "waiting_for_input", "waiting for user", "action required", "USER_INPUT", "permission required", "approval"]
    },
